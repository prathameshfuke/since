# Copy to .env and fill in. .env is git-ignored; never commit it.
# Free keys are enough for everything below.

# Main model (required). https://console.groq.com/keys
GROQ_API_KEY=

# Web search (required). https://langsearch.com  (supports exact date ranges)
LANGSEARCH_API_KEY=

# Fallback model and embeddings (strongly recommended). https://aistudio.google.com/apikey
# Without it: no semantic recall (keyword matching only) and no second model.
GEMINI_API_KEY=

# Optional: third model fallback. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: backup search provider if LangSearch is down. https://tavily.com
TAVILY_API_KEY=

# Optional, for a PUBLIC deployment only. Leave both empty for local runs (nothing is gated).
# SESSION_SECRET: any random string of 16+ characters. Turns on the proof-of-work session check.
# ACCESS_CODE: with SESSION_SECRET set, makes the demo invite-only.
SESSION_SECRET=
ACCESS_CODE=

# Optional: port (default 3000)
PORT=3000
